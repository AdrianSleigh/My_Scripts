SET NOCOUNT ON;

------------------------------------------------------------
-- PARAMETERS
------------------------------------------------------------
DECLARE 
    @HoursBack       int           = 24,          -- lookback window
    @TopN            int           = 50,          -- top offenders
    @IncludeLive     bit           = 1,           -- include live signals
    @IncludeWaits    bit           = 1,           -- include wait stats
    @IncludeQS       bit           = 1,           -- include Query Store
    @DatabaseFilter  nvarchar(max) = NULL;        -- comma list, NULL = all

DECLARE @Since datetime2(3) = DATEADD(hour, -@HoursBack, SYSDATETIME());

------------------------------------------------------------
-- 0) DISCOVER QUERY STORE DATABASES
------------------------------------------------------------
IF OBJECT_ID('tempdb..#QSDB') IS NOT NULL DROP TABLE #QSDB;
CREATE TABLE #QSDB
(
    name sysname NOT NULL,
    actual_state_desc nvarchar(60) NULL
);

INSERT #QSDB(name, actual_state_desc)
SELECT d.name, q.actual_state_desc
FROM sys.databases AS d
JOIN sys.database_query_store_options AS q
  ON d.database_id = q.database_id
WHERE d.is_query_store_on = 1
  AND d.state = 0
  AND d.database_id > 4
  AND (@DatabaseFilter IS NULL 
       OR d.name IN (SELECT value FROM STRING_SPLIT(@DatabaseFilter, ',')));

IF NOT EXISTS (SELECT 1 FROM #QSDB)
BEGIN
    PRINT 'No Query Store databases found.';
    RETURN;
END;

------------------------------------------------------------
-- 1) GATHER QUERY STORE METRICS
------------------------------------------------------------
IF @IncludeQS = 1
BEGIN
    IF OBJECT_ID('tempdb..#QDS') IS NOT NULL DROP TABLE #QDS;

    CREATE TABLE #QDS
    (
        database_name sysname NOT NULL,
        query_id bigint NOT NULL,
        plan_id  bigint NOT NULL,
        query_hash binary(8) NULL,
        plan_hash  binary(8) NULL,
        last_execution_time datetime2(3) NULL,
        avg_cpu_time bigint NULL,
        max_cpu_time bigint NULL,
        avg_duration bigint NULL,
        max_duration bigint NULL,
        avg_logical_io_reads bigint NULL,
        max_logical_io_reads bigint NULL,
        avg_physical_io_reads bigint NULL,
        max_physical_io_reads bigint NULL,
        count_executions bigint NULL,
        query_sql_text nvarchar(max) NULL
    );

    DECLARE @sql nvarchar(max) = N'';

    SELECT @sql = @sql + '
    BEGIN TRY
        INSERT #QDS
        SELECT
            DB_NAME() AS database_name,
            qsp.query_id,
            qsp.plan_id,
            qsq.query_hash,
            qsp.plan_hash,
            qsrs.last_execution_time,
            qsrs.avg_cpu_time,
            qsrs.max_cpu_time,
            qsrs.avg_duration,
            qsrs.max_duration,
            qsrs.avg_logical_io_reads,
            qsrs.max_logical_io_reads,
            CASE WHEN COL_LENGTH(''' + QUOTENAME(name) + '.sys.query_store_runtime_stats'', ''avg_physical_io_reads'') IS NOT NULL
                 THEN qsrs.avg_physical_io_reads END,
            CASE WHEN COL_LENGTH(''' + QUOTENAME(name) + '.sys.query_store_runtime_stats'', ''max_physical_io_reads'') IS NOT NULL
                 THEN qsrs.max_physical_io_reads END,
            qsrs.count_executions,
            qsqt.query_sql_text
        FROM ' + QUOTENAME(name) + '.sys.query_store_runtime_stats AS qsrs
        JOIN ' + QUOTENAME(name) + '.sys.query_store_runtime_stats_interval AS rsi
          ON qsrs.runtime_stats_interval_id = rsi.runtime_stats_interval_id
        JOIN ' + QUOTENAME(name) + '.sys.query_store_plan AS qsp
          ON qsrs.plan_id = qsp.plan_id
        JOIN ' + QUOTENAME(name) + '.sys.query_store_query AS qsq
          ON qsp.query_id = qsq.query_id
        JOIN ' + QUOTENAME(name) + '.sys.query_store_query_text AS qsqt
          ON qsq.query_text_id = qsqt.query_text_id
        WHERE rsi.start_time >= @Since;
    END TRY
    BEGIN CATCH
        PRINT ''QS read failed for database: ' + name + ''';
    END CATCH;
    '
    FROM #QSDB;

    EXEC sp_executesql @sql, N'@Since datetime2(3)', @Since=@Since;

    CREATE INDEX ix_qds ON #QDS(database_name, query_id);
END;

------------------------------------------------------------
-- 2) TOP OFFENDERS
------------------------------------------------------------
IF @IncludeQS = 1
BEGIN
    PRINT '===== TOP CPU (avg) =====';
    SELECT TOP (@TopN)
        database_name,
        avg_cpu_ms = avg_cpu_time/1000.0,
        max_cpu_ms = max_cpu_time/1000.0,
        count_executions,
        last_execution_time,
        LEFT(query_sql_text, 4000),
        query_id, plan_id, query_hash, plan_hash
    FROM #QDS
    ORDER BY avg_cpu_time DESC;

    PRINT '===== TOP DURATION (avg) =====';
    SELECT TOP (@TopN)
        database_name,
        avg_duration_ms = avg_duration/1000.0,
        max_duration_ms = max_duration/1000.0,
        count_executions,
        last_execution_time,
        LEFT(query_sql_text, 4000),
        query_id, plan_id, query_hash, plan_hash
    FROM #QDS
    ORDER BY avg_duration DESC;

    PRINT '===== TOP LOGICAL READS (avg) =====';
    SELECT TOP (@TopN)
        database_name,
        avg_logical_io_reads,
        max_logical_io_reads,
        count_executions,
        last_execution_time,
        LEFT(query_sql_text, 4000),
        query_id, plan_id, query_hash, plan_hash
    FROM #QDS
    ORDER BY avg_logical_io_reads DESC;

    PRINT '===== TOP PHYSICAL READS (avg) =====';
    SELECT TOP (@TopN)
        database_name,
        avg_physical_io_reads,
        max_physical_io_reads,
        count_executions,
        last_execution_time,
        LEFT(query_sql_text, 4000),
        query_id, plan_id, query_hash, plan_hash
    FROM #QDS
    ORDER BY ISNULL(avg_physical_io_reads,0) DESC;

    PRINT '===== CONSOLIDATED COST (CPU + Duration + Reads) =====';
    SELECT TOP (@TopN)
        database_name,
        query_id,
        total_cpu_ms      = SUM(avg_cpu_time),
        total_duration_ms = SUM(avg_duration),
        total_reads       = SUM(avg_logical_io_reads),
        exec_count        = SUM(count_executions),
        last_exec_time    = MAX(last_execution_time),
        sample_text       = LEFT(MAX(query_sql_text), 4000)
    FROM #QDS
    GROUP BY database_name, query_id
    ORDER BY total_cpu_ms DESC;
END;

------------------------------------------------------------
-- 3) LIVE SIGNALS
------------------------------------------------------------
IF @IncludeLive = 1
BEGIN
    PRINT '===== LIVE: PLE per NUMA Node =====';
    SELECT instance_name AS numa_node, cntr_value AS PLE
    FROM sys.dm_os_performance_counters
    WHERE counter_name = 'Page life expectancy'
      AND object_name LIKE '%Buffer Node%';

    PRINT '===== LIVE: Memory Grants Pending / Outstanding =====';
    SELECT 
      pending = (SELECT MAX(cntr_value) FROM sys.dm_os_performance_counters 
                 WHERE counter_name='Memory Grants Pending'),
      outstanding = (SELECT MAX(cntr_value) FROM sys.dm_os_performance_counters 
                     WHERE counter_name='Memory Grants Outstanding');

    PRINT '===== LIVE: Buffer vs Stolen vs Free (pages) =====';
    SELECT 
        stolen_pages   = SUM(CASE WHEN counter_name = 'Stolen pages'  THEN cntr_value END),
        database_pages = SUM(CASE WHEN counter_name = 'Database pages' THEN cntr_value END),
        free_pages     = SUM(CASE WHEN counter_name = 'Free pages'    THEN cntr_value END)
    FROM sys.dm_os_performance_counters
    WHERE object_name LIKE '%Buffer Manager%'
      AND counter_name IN ('Stolen pages','Database pages','Free pages');

    PRINT '===== LIVE: Active / Queued Memory Grants =====';
    SELECT TOP (@TopN)
        mg.session_id, mg.request_time, mg.grant_time,
        mg.requested_memory_kb, mg.granted_memory_kb, mg.used_memory_kb,
        is_queued = CASE WHEN mg.grant_time IS NULL THEN 1 ELSE 0 END,
        r.dop, r.status, r.command, r.wait_type, r.total_elapsed_time,
        DB_NAME(r.database_id) AS dbname,
        stmt_text = SUBSTRING(t.text, (r.statement_start_offset/2)+1,
                    (CASE WHEN r.statement_end_offset=-1
                          THEN LEN(CONVERT(nvarchar(max), t.text))*2
                          ELSE r.statement_end_offset END - r.statement_start_offset)/2+1)
    FROM sys.dm_exec_query_memory_grants AS mg
    JOIN sys.dm_exec_requests AS r
      ON mg.session_id = r.session_id AND mg.request_id = r.request_id
    CROSS APPLY sys.dm_exec_sql_text(r.sql_handle) AS t
    ORDER BY mg.requested_memory_kb DESC, mg.request_time ASC;

    PRINT '===== LIVE: Top Memory Clerks =====';
    SELECT TOP (@TopN)
        clerk_type = mc.type,
        pages_mb   = mc.pages_kb/1024.0,
        virtual_committed_mb = mc.virtual_memory_committed_kb/1024.0
    FROM sys.dm_os_memory_clerks AS mc
    WHERE mc.pages_kb > 0
    ORDER BY mc.pages_kb DESC;
END;

------------------------------------------------------------
-- 4) WAIT STATS (OPTIONAL)
------------------------------------------------------------
IF @IncludeWaits = 1
BEGIN
    PRINT '===== TOP WAITS (excluding benign) =====';
    SELECT TOP (@TopN)
        wait_type,
        wait_s = wait_time_ms/1000.0,
        signal_s = signal_wait_time_ms/1000.0,
        waiting_tasks_count
    FROM sys.dm_os_wait_stats
    WHERE wait_type NOT LIKE 'SLEEP%'
      AND wait_type NOT LIKE 'BROKER%'
      AND wait_type NOT LIKE 'XE%'
    ORDER BY wait_time_ms DESC;
END;

PRINT '===== Dashboard completed at ' + CONVERT(varchar(30), SYSDATETIME(), 121) + ' =====';
